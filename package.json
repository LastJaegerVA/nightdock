{
  "name": "nightdock",
  "productName": "Nightdock",
  "version": "1.4.0",
  "description": "Every game launcher in one place",
  "author": {
    "name": "LastJaegerVA",
    "email": "LastJaegerVA@users.noreply.github.com",
    "url": "https://github.com/LastJaegerVA"
  },
  "homepage": "https://github.com/LastJaegerVA/nightdock",
  "license": "MIT",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win dir && python3 build/make-installer.py dist/win-unpacked $npm_package_version dist/Nightdock-Setup-$npm_package_version.exe && cd dist/win-unpacked && zip -qr9 ../Nightdock-Portable-$npm_package_version-windows.zip .",
    "dist:linux": "electron-builder --linux dir && for t in AppImage tar.gz deb pacman rpm; do electron-builder --linux $t --prepackaged dist/linux-unpacked || exit 1; done"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "resedit": "^1.7.2"
  },
  "build": {
    "appId": "io.github.lastjaegerva.nightdock",
    "productName": "Nightdock",
    "artifactName": "Nightdock-${version}-${os}-${arch}.${ext}",
    "files": [
      "src/**",
      "renderer/**",
      "build/icon.png",
      "package.json",
      "!build/afterPack.js"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "signAndEditExecutable": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "pacman",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Game",
      "executableName": "nightdock",
      "maintainer": "LastJaegerVA <LastJaegerVA@users.noreply.github.com>",
      "synopsis": "Every game launcher in one place",
      "desktop": {
        "StartupWMClass": "Nightdock"
      }
    },
    "pacman": {
      "depends": [
        "gtk3",
        "nss",
        "alsa-lib",
        "libxss",
        "libnotify",
        "libxtst",
        "xdg-utils"
      ],
      "artifactName": "nightdock-${version}-x86_64.pkg.tar.xz"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libnotify4"
      ],
      "artifactName": "nightdock_${version}_amd64.${ext}"
    },
    "rpm": {
      "depends": [
        "gtk3",
        "nss",
        "libXScrnSaver",
        "libXtst",
        "xdg-utils",
        "at-spi2-core",
        "libuuid",
        "libnotify"
      ],
      "artifactName": "nightdock-${version}.x86_64.${ext}",
      "fpm": [
        "--rpm-compression",
        "gzip",
        "--rpm-rpmbuild-define",
        "_build_id_links none"
      ]
    },
    "afterPack": "build/afterPack.js",
    "publish": null
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LastJaegerVA/nightdock.git"
  },
  "bugs": {
    "url": "https://github.com/LastJaegerVA/nightdock/issues"
  },
  "keywords": [
    "game launcher",
    "launcher",
    "steam",
    "ubisoft connect",
    "epic games",
    "lutris",
    "heroic",
    "electron",
    "linux",
    "windows"
  ]
}
